# Copy to .env.local for local development. On Vercel, add these under
# Project > Settings > Environment Variables.

# Which provider takes payments: stripe | chase | mock
# Defaults to "stripe" when STRIPE_SECRET_KEY is set, otherwise "mock".
PAYMENT_PROVIDER=stripe

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
# From the webhook endpoint you create for https://<your-domain>/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# Chase Payment Solutions (placeholder; see lib/payments/chase.ts)
# CHASE_MERCHANT_ID=
# CHASE_API_KEY=

# Mock provider: fake "pay" page for local work and previews. Refused in
# production unless ALLOW_MOCK_PAYMENTS=true.
# ALLOW_MOCK_PAYMENTS=true
# MOCK_PAYMENT_SECRET=any-long-random-string

# Public URL used in the return links the payment provider redirects to.
# Optional on Vercel (VERCEL_URL is used), required if you use a custom domain
# before it is set as the production domain.
# NEXT_PUBLIC_SITE_URL=https://crayonspizza.com
